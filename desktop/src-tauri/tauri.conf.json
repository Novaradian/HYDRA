{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HYDRA",
  "version": "0.8.0",
  "identifier": "io.github.hydra.cad",
  "build": { "frontendDist": "../../dist/HYDRA" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "HYDRA", "url": "HYDRA.html", "width": 1600, "height": 960, "minWidth": 1100, "minHeight": 620, "center": true, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Jignesh",
    "copyright": "Copyright (c) 2026 Jignesh · MIT licence",
    "shortDescription": "Offline hydraulic, pneumatic and electrical CAD and simulator",
    "fileAssociations": [{ "ext": ["hydra"], "name": "HYDRA project", "description": "HYDRA project", "role": "Editor", "mimeType": "application/zip" }],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "nsis": { "installMode": "currentUser" } }
  }
}
